// https://docs.renovatebot.com/config-overview/#inherited-config

// NOTES:
// All values configurable in the Mend App UI are overriden here, except for:
// - Dependency Updates (when this is disabled, Renovate is not started for this repo)
// - Dependency Updates >> Renovate >> Automated PRs (
// 		when both this and 'Silent' are disabled, "dependencyDashboardApproval" is enabled
//		with a catch-all packageRules
// )
// onboarding* settings are global-only

{
	"$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
	// forces the default fork processing mode for the Mend Renovate App (auto probably makes no sense)
	"forkProcessing": "auto",
	// overrides configuration from the Mend App UI with the default
	"mode": "full",
	// overrides configuration from the Mend App UI with the default
	"onboarding": true,
	// sets the expected autodetected value as a fallback
	"onboardingConfig": {
		"$schema": "https://docs.renovatebot.com/renovate-schema.json",
		"extends": [
			"local>mestriga-org/renovate-config"
		]
	},
	// moves the default config file off the repo root
	"onboardingConfigFileName": ".github/renovate.json",
	// forces enablement of onboarding for discovered repositories with no dependencies
	"onboardingNoDeps": "enabled",
	// overrides configuration from the Mend App UI with the default
	"requireConfig": "required"
}
