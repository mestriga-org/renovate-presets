{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		":approveMajorUpdates",
		":automergeMinor",
		":maintainLockFilesWeekly",
		":prHourlyLimitNone",
		":rebaseStalePrs"
	],
	"hostRules": [
		{
			"abortOnError": true
		}
	],
	"internalChecksAsSuccess": true,
	"labels": [
		"dependencies"
	],
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			"matchDatasources": [
				"terraform-module",
				"terraform-provider"
			],
			"registryUrls": [
				"https://registry.opentofu.org"
			]
		},
		{
			"groupName": "node dependencies",
			"matchDepTypes": ["!packageManager"],
			"matchManagers": ["npm"]
		}
	],
	"platformAutomerge": false,
	"vulnerabilityAlerts": {
		"addLabels": [
			"security"
		]
	}
}
