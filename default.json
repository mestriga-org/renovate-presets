// This is the organization's default preset.
{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		// config:best-practices extends config:recommended with settings for pinning, abandonment, config migration and minimumReleaseAge
		"config:best-practices",
		":automergeDigest",
		":assignee(mestriga)",
		":configMigration",
		// has repo config requirements: https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts
		":enableVulnerabilityAlertsWithAdditionalLabel(security)",
		":label(dependencies)", // same as Dependabot's default
		":prHourlyLimitNone",
		":rebaseStalePrs",
		":timezone(America/Sao_Paulo)",
		"customManagers:biomeVersions"
	],
	"customManagers": [
		{
			"customType": "jsonata",
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "Azure/bicep",
			"depTypeTemplate": "uses-with",
			"description": "Updates the input specifying the bicep version of the Azure/bicep-deploy and anthony-c-martin/setup-bicep GHAs.",
			"fileFormat": "yaml",
			"managerFilePatterns": [
				"/^(workflow-templates|\\.(github|gitea|forgejo)/workflows)/[^/]+\\.ya?ml$/",
				"/(^|/)action\\.ya?ml$/"
			],
			"matchStrings": [
				"$append(jobs.*, runs).steps[uses ~> /^Azure\\/bicep-deploy(@|$)/i].{ \"currentValue\": with.bicep-version }",
				"$append(jobs.*, runs).steps[uses ~> /^anthony-c-martin\\/setup-bicep(@|$)/i].{ \"currentValue\": with.version }"
			],
			"versioningTemplate": "semver"
		},
		{
			// TODO filter out 'latest'
			"customType": "jsonata",
			"datasourceTemplate": "nuget",
			"depNameTemplate": "Az",
			"depTypeTemplate": "uses-with",
			"description": "Updates the azPSVersion input of the Azure/powershell GHA.",
			"fileFormat": "yaml",
			"managerFilePatterns": [
				"/^(workflow-templates|\\.(github|gitea|forgejo)/workflows)/[^/]+\\.ya?ml$/",
				"/(^|/)action\\.ya?ml$/"
			],
			"matchStrings": [
				"$append(jobs.*, runs).steps[uses ~> /^Azure\\/powershell(@|$)/i].{ \"currentValue\": with.azPSVersion }"
			],
			"registryUrlTemplate": "https://www.powershellgallery.com/api/v2"
		}
	],
	"dependencyDashboardLabels": ["dependencies"],
	"dependencyDashboardOSVVulnerabilitySummary": "all",
	"lockFileMaintenance": { "automerge": true },
	"logLevelRemap": [
		{
			"description": "v43.77 lib/modules/manager/npm/extract/pnpm.ts trace",
			"matchMessage": "Failed to find required \"packages\" array in pnpm-workspace.yaml",
			"newLogLevel": "warn"
		},
		{
			"description": "v43.77 lib/modules/manager/npm/extract/pnpm.ts trace",
			"matchMessage": "Failed to parse pnpm-workspace.yaml",
			"newLogLevel": "warn"
		},
		{
			"description": "v43.77 lib/modules/manager/npm/extract/pnpm.ts trace",
			"matchMessage": "Failed to locate pnpm-workspace.yaml in a parent directory.",
			"newLogLevel": "warn"
		},
		{
			"description": "v43.77 lib/modules/manager/npm/extract/pnpm.ts trace",
			"matchMessage": "Failed to find a pnpm-lock.yaml sibling for the workspace.",
			"newLogLevel": "warn"
		},
		{
			"description": "v43.77 lib/modules/manager/npm/extract/pnpm.ts trace",
			"matchMessage": "Didn't find the package in the pnpm workspace",
			"newLogLevel": "warn"
		}
	],
	/*
		enable minimumReleaseAge for all updates, but set minimumReleaseAgeBehaior
		to timestamp-optional to allow updates to proceed with a warning
	*/
	"minimumReleaseAge": "3 days",
	"minimumReleaseAgeBehaviour": "timestamp-optional",
	/*
	for pnpm v10.32
	only includes settings that are relevant with --lockfile-only --ignore-scripts
	notable setttings:
	- engine-strict is shared with npm
	- strict-peer-deps is for npm only
	- lockfile-only and ignore-pnpmfile are included to affect the pnpm-dedupe post-update command:
		- https://github.com/renovatebot/renovate/blob/43.66.4/lib/modules/manager/npm/post-update/pnpm.ts#L152
		- https://github.com/renovatebot/renovate/discussions/41965
	*/
	"npmrc": "bail=false\nblock-exotic-subdeps=true\ndisallow-workspace-cycles=true\nengine-strict=true\nfail-if-no-match=true\nignore-patch-failures=false\nignore-pnpmfile=true\nlockfile-only=true\nminimum-release-age=1440\noptimistic-repeat-install=true\npackage-manager-strict-version=true\nstrict-dep-builds=true\nstrict-peer-dependencies=true\nstrict-peer-deps=true\ntrust-policy=no-downgrade",
	"npmrcMerge": true,
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			"automerge": true,
			"description": "Automerge non-breaking updates",
			"matchJsonata": ["$not(isBreaking)"]
		},
		{
			"description": "Group non-breaking updates",
			"groupName": "all non-breaking dependencies",
			"groupSlug": "all-non-breaking",
			"matchJsonata": ["$not(isBreaking)"]
		},
		{
			// based on helper:pinGitHubActionDigestsToSemver
			// "https://github.com/renovatebot/renovate/blob/43.96.0/lib/config/presets/internal/helpers.preset.ts#L74-L85"
			"description": "Convert pinned GitHub Action digests to SemVer.",
			"extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
			"matchDepTypes": ["action"],
			"matchDatasources": ["github-tags"],
			"versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
		},
		{
			"description": "Require timestamps for the npm data source",
			"matchDatasources": ["npm"],
			"minimumReleaseAgeBehaviour": "timestamp-required"
		},
		{
			"description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
			"matchUpdateTypes": ["lockFileMaintenance"],
			// TODO determine if prBodyNotes are merged and deduplicate this note if needed
			"prBodyNotes": ["⚠️ Renovate's lock file maintenance functionality does not support validating Minimum Release Age, as the package manager performs the required changes to update package(s). Confirm whether your package manager perform its own validation for the Minimum Release Age of packages."],
			"minimumReleaseAgeBehaviour": "timestamp-required",
			"minimumReleaseAge": null
		},
		{
			"description": "Override default registry URL for the terraform-module and terraform-provider data sources in *.tofu files",
			"matchDatasources": ["terraform-{module,provider}"],
			"matchFileNames": ["**/*.tofu"],
			"registryUrls": ["https://registry.opentofu.org"]
		},
		{
			// NOTE: overrideDepName made renovate run fail (2025-11-28)
			"description": "Override package name for required_version terraform dependencies in *.tofu files.",
			"matchDepNames": ["hashicorp/terraform"],
			"matchDepTypes": ["required_version"],
			"matchFileNames": ["**/*.tofu"],
			"matchManagers": ["terraform"],
			"overridePackageName": "opentofu/opentofu"
		},
		{
			// NOTE: did not try to set overrideDepName
			"description": "Override package name for terraform-version dependencies in .opentofu-version files.",
			"matchDepNames": ["hashicorp/terraform"],
			"matchFileNames": ["/(^|/)\\.opentofu-version$/"],
			"matchManagers": ["terraform-version"],
			"overridePackageName": "opentofu/opentofu"
		}
	],
	"pinDigest": { "automerge": true },
	// ensures consistent behavior without configuration of branch protection rules
	// and when rebaseWhen=auto (already disabled for free private GitHub repositories)
	"platformAutomerge": false,
	"postUpdateOptions": [
		"npmDedupe",
		"pnpmDedupe",
		"yarnDedupeHighest"
	],
	"semanticCommits": "enabled",
	"terraform-version": {
		"managerFilePatterns": ["/(^|/)\\.opentofu-version$/"]
	}
}
