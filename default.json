// This is the organization's default preset.
{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		// config:best-practices extends config:recommended with settings for pinning, abandonment, config migration and minimumReleaseAge
		"config:best-practices",
		":automergeDigest",
		":assignee(mestriga)",
		":configMigration",
		// has repo config requirements: https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts
		":enableVulnerabilityAlertsWithAdditionalLabel(security)",
		":label(dependencies)", // same as Dependabot's default
		":separateMultipleMajorReleases",
		":timezone(America/Sao_Paulo)",
		"/presets/custom-managers",
		"/presets/opentofu",
		"/presets/pnpm"
	],
	"dependencyDashboardLabels": ["dependencies"],
	"dependencyDashboardOSVVulnerabilitySummary": "all",
	"lockFileMaintenance": {
		"automerge": true,
		"prHourlyLimit": 0
	},
	// allows CalVer updates
	"maxMajorIncrement": 100000,
	/*
		enable minimumReleaseAge for all updates, but set minimumReleaseAgeBehaior
		to timestamp-optional to allow updates to proceed with a warning
	*/
	"minimumReleaseAge": "3 days",
	"minimumReleaseAgeBehaviour": "timestamp-optional",
	"nodenv": {
		"ignoreUnstable": false
	},
	"npm": {
		"minimumReleaseAgeBehaviour": "timestamp-required"
	},
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			"automerge": true,
			"description": "Automerge non-breaking updates",
			"matchJsonata": ["$not(isBreaking)"]
		},
		{
			"description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
			"matchUpdateTypes": ["lockFileMaintenance"],
			// TODO determine if prBodyNotes are merged and deduplicate this note if needed
			"prBodyNotes": ["⚠️ Renovate's lock file maintenance functionality does not support validating Minimum Release Age, as the package manager performs the required changes to update package(s). Confirm whether your package manager perform its own validation for the Minimum Release Age of packages."],
			"minimumReleaseAgeBehaviour": "timestamp-required",
			"minimumReleaseAge": null
		},
		{
			"groupName": "workers-sdk monorepo",
			"matchSourceUrls": [
				"https://github.com/cloudflare/cf",
				"https://github.com/cloudflare/workers-sdk"
			],
			"matchUpdateTypes": [
				"digest",
				"patch",
				"minor",
				"major"
			]
		}
	],
	"pinDigest": { "automerge": true },
	"rangeStrategy": "bump",
	"semanticCommits": "enabled",
	"statusCheckWhen": {
		"artifactError": "always"
	}
}
