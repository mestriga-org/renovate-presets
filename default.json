{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		":approveMajorUpdates",
		":automergePatch",
		":maintainLockFilesWeekly",
		"npm:unpublishSafe"
	],
	"labels": [
		"dependencies"
	],
	"osvVulnerabilityAlerts": true,
	"vulnerabilityAlerts": {
		"addLabels": [
			"security"
		]
  },
	"packageRules": [
		{
			"matchDatasources": [
				"terraform-module",
				"terraform-provider"
			],
			"registryUrls": [
				"https://registry.opentofu.org"
			]
		}
	]
}
