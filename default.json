// This is the organization's default preset.
{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		// config:best-practices extends config:recommended with settings for pinning, abandonment, config migration and minimumReleaseAge
		"config:best-practices",
		":assignee(mestriga)",
		":automergeMinor",
		":configMigration",
		":enableVulnerabilityAlertsWithAdditionalLabel(security)",
		":label(dependencies)", // same as Dependabot's default
		":maintainLockFilesWeekly",
		":prHourlyLimitNone",
		":rebaseStalePrs",
		":timezone(America/Sao_Paulo)",
		"customManagers:dockerfileVersions",
		"customManagers:githubActionsVersions",
		"customManagers:tfvarsVersions",
		"group:allNonMajor"
	],
	"customManagers": [
		// TODO make this work with actions
		{
			"customType": "jsonata",
			"fileFormat": "yaml",
			"managerFilePatterns": [".github/workflows/*.{yml,yaml}"],
			"matchStrings": ["jobs.*.steps[uses ~> /^anthony-c-martin\\/setup-bicep(@|$)/].{ \"currentValue\": with.version }"],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "Azure/bicep",
			"versioningTemplate": "semver"
		},
		{
			"customType": "jsonata",
			"fileFormat": "yaml",
			"managerFilePatterns": ["**/action.{yml,yaml}"],
			"matchStrings": ["runs.steps[uses ~> /^anthony-c-martin\\/setup-bicep(@|$)/].{ \"currentValue\": with.version }"],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "Azure/bicep",
			"versioningTemplate": "semver"
		}
	],
	"dependencyDashboardOSVVulnerabilitySummary": "all",
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		// OpenTofu
		{
			"matchFileNames": ["**/*.tofu"],
			"matchDatasources": ["terraform-{module,provider}"],
			"registryUrls": ["https://registry.opentofu.org"]
		},
		{
			"matchFileNames": ["**/*.tofu"],
			"matchManagers": ["terraform"],
			"matchDepTypes": ["required_version"],
			"overridePackageName": "opentofu/opentofu"
		},
		{
			"matchFileNames": ["/(^|/)\\.opentofu-version$/"],
			"matchManagers": ["terraform-version"],
			"overridePackageName": "opentofu/opentofu"
		}
	],
	// ensures consistent behavior without configuration of branch protection rules
	// and when rebaseWhen=auto (already disabled for free private GitHub repositories)
	"platformAutomerge": false,
	// dedupes node packages
	"postUpdateOptions": [
		"npmDedupe",
		"pnpmDedupe",
		"yarnDedupeHighest"
	],
	// OpenTofu
	"terraform-version": {
		"managerFilePatterns": [
			"/(^|/)\\.opentofu-version$/"
		]
	}
}
