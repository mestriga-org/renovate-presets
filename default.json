// This is the organization's default preset.
// important options with defaults implied:
// - https://docs.renovatebot.com/configuration-options/#rebasewhen
// TODO: determine precedence of config set in and out of package rules
{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices", // config:recommended with pinning, abandonment and config migration
		":approveMajorUpdates",
		":automergeMinor",
		":configMigration",
		":maintainLockFilesWeekly",
		":prHourlyLimitNone",
		"security:minimumReleaseAgeNpm"
	],
	"assignees": ["mestriga"],
	"dependencyDashboardOSVVulnerabilitySummary": "all",
	"hostRules": [
		{ "abortOnError": true }
	],
	"internalChecksAsSuccess": true,
	"labels": ["dependencies"],
	"osvVulnerabilityAlerts": true,
	"packageRules": [
		{
			// defaults terraform modules and providers to OpenTofu registry
			"matchDatasources": ["terraform-{module,provider}"],
			"registryUrls": ["https://registry.opentofu.org"]
		},
		{
			// groups NPM dependencies to prevent breaking peer requirements
			"groupName": "node dependencies",
			"matchDepTypes": ["!packageManager"],
			"matchManagers": ["npm"]
		}
	],
	// ensures consistent behavior without configuration of branch protection rules and when rebaseWhen=auto
	"platformAutomerge": false, // (not available for free private repositories)
	"vulnerabilityAlerts": {
		"addLabels": ["security"]
	}
}
