* text=auto
* whitespace=tabwidth=4,indent-with-non-tab

.editorconfig  text
.gitattributes text
.gitignore     text
*.md           text
/.npmrc        text

*.json text whitespace=tabwidth=2,indent-with-non-tab
*.ts   text whitespace=tabwidth=2,indent-with-non-tab

*.sh text eol=lf

*.yaml text whitespace=tabwidth=2,tab-in-indent
*.yml  text whitespace=tabwidth=2,tab-in-indent

/package.json        eol=lf
/pnpm-lock.yaml      eol=lf
/pnpm-workspace.yaml eol=lf

/.node-version text working-tree-encoding=ASCII
